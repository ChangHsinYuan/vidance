# Output
output/
output/output

# Local-only config overrides (never commit)
config/config.local.json

# Voice samples & custom voices (keep directory structure, ignore audio)
voice_samples/
voices/*
!voices/README.md

# BGM custom audio (keep directory, ignore wavs)
bgm/*.wav
bgm/*.mp3

# Assets videos (keep images, ignore demo mp4s)
assets/*.mp4

# Input materials (user-uploaded test videos, keep dirs, ignore videos)
input/**/*.mp4

# SKILL demo videos (big binaries, regenerate locally; yaml 进 git，demo 不进)
SKILL/**/*.demo.mp4

# Generated LUTs (regenerated by gen_luts.py)
utils/luts/*.cube

# Python
__pycache__/
*.pyc

# Temp
compaction.md
*.tmp


