  "23": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["11", 0]}},
  "26": {"class_type": "InpaintModelConditioning", "inputs": {"positive": ["22", 0], "negative": ["23", 0], "vae": ["12", 0], "pixels": ["20", 0], "mask": ["21", 0], "noise_mask": true}},
